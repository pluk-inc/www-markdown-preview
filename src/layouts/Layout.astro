---
import "../styles/global.css";
import SupportPrompt from "../components/SupportPrompt.astro";
import PostHog from "../components/posthog.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Markdown Preview — Read .md files on your Mac",
  description = "A free Mac app that opens .md (Markdown) files as clean, readable documents. No setup, no account. Quick Look previews, document outline, open source.",
  image = "/screenshots/hero@2x.png",
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1216" />
    <meta property="og:image:height" content="735" />
    <meta property="og:image:alt" content="Markdown Preview rendering a README on a MacBook Pro" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content="Markdown Preview rendering a README on a MacBook Pro" />
    <title>{title}</title>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <PostHog />
  </head>
  <body>
    <slot />
    <SupportPrompt />
  </body>
</html>
