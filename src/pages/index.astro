---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import AnimatedLogo from "../components/AnimatedLogo.astro";
import FeatureCard from "../components/FeatureCard.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import SiteNav from "../components/SiteNav.astro";
import {
  DOWNLOAD_URL as downloadUrl,
  RELEASES_URL as releasesUrl,
  REPO_URL as repoUrl,
  SITE as siteUrl,
} from "../consts";

const publicDir = path.resolve("./public");
const shot = (rel: string) =>
  fs.existsSync(path.join(publicDir, rel)) ? `/${rel}` : undefined;

const heroShot = shot("screenshots/hero@2x.png");
const feelsNativeShot = shot("screenshots/feels-native@2x.png");
const quickLookShot = shot("screenshots/quicklook@2x.png");
const outlineShot = shot("screenshots/outline@2x.png");
const openWithShot = shot("screenshots/open-with@2x.png");

const softwareApplicationJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Markdown Preview",
  applicationCategory: "ProductivityApplication",
  operatingSystem: "macOS 15 or later",
  description:
    "A free Mac app that opens .md (Markdown) files as clean, readable documents. Quick Look previews, document outline, and Open With handoff.",
  url: siteUrl,
  downloadUrl,
  codeRepository: repoUrl,
  license: `${repoUrl}/blob/main/LICENSE`,
  image: `${siteUrl}/screenshots/hero@2x.png`,
  screenshot: `${siteUrl}/screenshots/hero@2x.png`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    url: downloadUrl,
  },
};

/* One source of truth for the FAQ: rendered on the page and emitted as
   FAQPage JSON-LD so answer engines can quote it directly. Plain text only. */
const faq = [
  {
    q: "What is a .md file?",
    a: ".md is short for Markdown — a plain-text way of writing documents. It's used for notes, project docs, README files, and most of what AI tools like ChatGPT and Claude produce. Opened in a plain text editor it looks like code, full of # and ** symbols. Opened in Markdown Preview, it reads like a normal formatted document.",
  },
  {
    q: "What is Markdown Preview for?",
    a: "It turns .md files into clean, readable documents. Double-click a file and you get proper headings, lists, and tables instead of raw text. When you want to make changes, one click hands the file to whichever editor you prefer.",
  },
  {
    q: "Do I need to be technical to use it?",
    a: "No. Download it, drag it into Applications, and double-click any .md file. There is nothing to set up and no account to create.",
  },
  {
    q: "Does it work with Finder previews?",
    a: "Yes. Select any .md file in Finder and press the space bar — the formatted document appears instantly, without opening an app.",
  },
  {
    q: "How is it different from Typora or Marked?",
    a: "Those are editors for writing Markdown. Markdown Preview focuses on reading: it opens files instantly, previews them straight from Finder, and hands off to your editor when you want to write. It sits beside VS Code, Cursor, Zed, or whichever app you already use.",
  },
  {
    q: "Is it free?",
    a: "Yes — free and open source (MIT licensed), with no ads and no paid version. If it's useful to you, small contributions are welcome but never required; they help keep it free for everyone.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};

const editorTiles = [
  { name: "VS Code", bg: "#0078d4", letter: "V" },
  { name: "Cursor", bg: "#000000", letter: "C" },
  { name: "Zed", bg: "#7c5cff", letter: "Z" },
  { name: "Sublime", bg: "#ff9800", letter: "S" },
  { name: "Nova", bg: "#1e3a8a", letter: "N" },
  { name: "TextMate", bg: "#3b3b3b", letter: "T" },
  { name: "BBEdit", bg: "#dc2626", letter: "B" },
  { name: "Xcode", bg: "#147efb", letter: "X" },
  { name: "Vim", bg: "#019733", letter: "V" },
];
---

<Layout jsonLd={[softwareApplicationJsonLd, faqJsonLd]}>
  <SiteNav />

  {/* ───────── Hero ───────── */}
  <section class="bg-[var(--color-fog)]">
    <div class="mx-auto max-w-[1200px] px-6 pt-24 sm:pt-[82px] pb-20 sm:pb-20 text-center">
      <AnimatedLogo class="mx-auto mb-7 sm:mb-9" />
      <p class="hero-eyebrow text-[var(--color-ink)]">Markdown Preview</p>
      <h1 class="hero-title sm:-mt-1">
        <span class="block">Your .md files,</span>
        <span class="block">finally readable.</span>
      </h1>
      <p class="hero-sub mx-auto">
        The free Mac app that turns raw Markdown files into clean documents you can
        actually read. No setup, no account — just open the file.
      </p>
    </div>

    {heroShot && (
      <div class="mx-auto max-w-[1100px] pt-12 sm:pt-10 px-6 pb-32 sm:pb-[120px]">
        <img
          src={heroShot}
          alt="Markdown Preview rendering a README on a MacBook Pro"
          class="block w-full h-auto"
          width="1216"
          height="735"
          decoding="async"
          loading="eager"
        />
      </div>
    )}
  </section>

  {/* ───────── Trusted by ───────── */}
  <LogoMarquee />

  {/* ───────── Before / after ───────── */}
  <section id="before-after" class="bg-[var(--color-fog)]">
    <div class="mx-auto max-w-[1200px] px-6 pt-32 sm:pt-[120px] pb-14 text-center">
      <h2 class="section-title mx-auto text-[var(--color-ink)]">
        Ever opened a .md file<br class="hidden sm:inline"/> and seen this?
      </h2>
      <p class="ba-intro mx-auto">
        Notes, docs, and almost everything AI tools write come as Markdown — plain text
        sprinkled with <span class="font-mono">#</span> and <span class="font-mono">**</span>
        symbols. Same file, two very different reading experiences.
      </p>
    </div>

    <div class="mx-auto max-w-[1060px] px-6 pb-32 sm:pb-[120px]">
      <div class="ba-grid">
        <figure class="ba-pane">
          <div class="ba-window">
            <div class="ba-titlebar">
              <span class="ba-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="ba-filename">launch-plan.md</span>
            </div>
            <pre class="ba-raw"># Launch plan

Everything we need before the
**August 15** launch.

## This week

- Finalize the pricing page
- Send the announcement email
- Brief the support team

&gt; Demo for the sales team
&gt; on Friday.</pre>
          </div>
          <figcaption class="ba-caption"><strong>Before</strong> — what your Mac shows you</figcaption>
        </figure>

        <div class="ba-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </div>

        <figure class="ba-pane">
          <div class="ba-window">
            <div class="ba-titlebar">
              <span class="ba-lights ba-lights--color" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="ba-filename">launch-plan.md</span>
            </div>
            <div class="ba-rendered">
              <h3>Launch plan</h3>
              <p>Everything we need before the <strong>August 15</strong> launch.</p>
              <h4>This week</h4>
              <ul>
                <li>Finalize the pricing page</li>
                <li>Send the announcement email</li>
                <li>Brief the support team</li>
              </ul>
              <blockquote>Demo for the sales team on Friday.</blockquote>
            </div>
          </div>
          <figcaption class="ba-caption"><strong>After</strong> — the same file in Markdown Preview</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ───────── Features ───────── */}
  <section id="features" class="bg-[var(--color-snow)]">
    <div class="mx-auto max-w-[1200px] px-6 pt-32 sm:pt-[120px] pb-20 sm:pb-20">
      <h2 class="section-title text-[var(--color-ink)]">
        Designed to disappear.<br class="hidden sm:inline"/> Built to feel native.
      </h2>
    </div>

    {/* Spacer divs at the start/end + matching scroll-padding align card edges
        with the title's container at every viewport size. */}
    <div id="features-scroller" class="features-scroller pb-12">
      <div class="flex gap-5 sm:gap-6">
        <div class="features-spacer" aria-hidden="true"></div>

        <FeatureCard
          src={feelsNativeShot}
          alt="Markdown Preview rendering a Markdown document natively on macOS"
          lead="Feels native."
        >
          Designed for the Mac with the polish of a system app. It opens instantly, needs no account or setup, and respects every shortcut you already know. Install it once and forget it's there.

          <div slot="fallback" class="card-mock-wrap">
            <div class="card-mock-paper">
              <h4 class="card-mock-title">On reading.</h4>
              <p class="t-caption mt-1 text-[var(--color-graphite)]">An essay.</p>
              <p class="t-body-sm mt-4 text-[var(--color-slate)] leading-[1.6]">
                Reading is a quiet act. The text should be present, the chrome absent. Margins generous, leading patient.
              </p>
              <p class="t-body-sm mt-3 italic text-[var(--color-slate)] leading-[1.6] border-l-2 border-[var(--color-silver-mist)] pl-3">
                A small inflection where the writer pauses to think.
              </p>
            </div>
          </div>
        </FeatureCard>

        <FeatureCard
          src={outlineShot}
          alt="Markdown Preview document outline sidebar showing every heading as a navigable list"
          lead="Find your place."
        >
          Every heading becomes a navigable table of contents. Click to jump between sections, or scroll naturally — the active heading follows you down the page.

          <div slot="fallback" class="card-mock-wrap">
            <div class="card-mock-paper card-mock-paper--narrow">
              <p class="text-[10px] tracking-[0.16em] uppercase font-semibold text-[var(--color-graphite)] mb-3">Outline</p>
              <ul class="space-y-1 t-body-sm">
                <li class="px-3 py-1.5 bg-[var(--color-silver-mist)] font-medium text-[var(--color-ink)] rounded-md">Introduction</li>
                <li class="px-3 py-1.5 text-[var(--color-slate)]">Architecture</li>
                <li class="pl-7 pr-3 py-1.5 text-[var(--color-graphite)]">App lifecycle</li>
                <li class="pl-7 pr-3 py-1.5 text-[var(--color-graphite)]">WKWebView pipeline</li>
                <li class="pl-7 pr-3 py-1.5 text-[var(--color-graphite)]">Markdown parsing</li>
                <li class="px-3 py-1.5 text-[var(--color-slate)]">Quick Look extension</li>
                <li class="px-3 py-1.5 text-[var(--color-slate)]">Release process</li>
              </ul>
            </div>
          </div>
        </FeatureCard>

        <FeatureCard
          src={quickLookShot}
          alt="Quick Look preview of a Markdown file in Finder"
          lead="Just press space."
          wide
        >
          On any <span class="font-mono">.md</span> file in Finder, the bundled Quick Look extension renders the document inline. Spotlight previews use the same renderer.

          <div slot="fallback" class="card-mock-wrap card-mock-wrap--column">
            <kbd class="kbd-key">Space</kbd>
            <p class="t-body-sm text-[var(--color-graphite)]">Preview in Finder.</p>
          </div>
        </FeatureCard>

        <FeatureCard
          src={openWithShot}
          alt="Open With picker showing Typora, Xcode, Cursor, Zed, TextEdit and Numbers as Markdown editors"
          align="right-top"
          lead="Edit when you're ready."
        >
          When you want to write, Markdown Preview hands off to your editor of choice — VS Code, Cursor, Zed, Sublime, or any other Markdown-aware app. The picker remembers your last choice.

          <div slot="fallback" class="card-mock-wrap">
            <div class="grid grid-cols-3 gap-4 max-w-[300px]">
              {editorTiles.map((app) => (
                <div class="editor-tile" style={`background:${app.bg}`} title={app.name}>{app.letter}</div>
              ))}
            </div>
          </div>
        </FeatureCard>

        <div class="features-spacer" aria-hidden="true"></div>
      </div>
    </div>

    {/* Pagination arrows */}
    <div class="mx-auto max-w-[1200px] px-6 pb-32 sm:pb-[120px] flex justify-end gap-2">
      <button id="features-prev" type="button" aria-label="Previous" class="arrow-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
      </button>
      <button id="features-next" type="button" aria-label="Next" class="arrow-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
      </button>
    </div>
  </section>

  {/* ───────── FAQ ───────── */}
  <section class="bg-[var(--color-snow)]">
    <div class="mx-auto max-w-[920px] px-6 py-28 sm:py-[112px]">
      <h2 class="faq-title text-[var(--color-ink)]">Questions before you install.</h2>
      <dl class="mt-14 faq-list">
        {faq.map(({ q, a }) => (
          <div class="faq-item">
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ───────── Closing call ───────── */}
  <section class="bg-[var(--color-fog)]">
    <div class="mx-auto max-w-[820px] px-6 py-32 sm:py-[120px] text-center">
      <h2 class="closing-title text-[var(--color-ink)]">
        Free. Open source.<br/>
        <span class="text-[var(--color-graphite)]">Built for the Mac.</span>
      </h2>
      <div class="mt-12 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-5">
        <a href={downloadUrl} class="btn-pill" id="cta-download">Download for macOS</a>
        <a href={repoUrl} class="btn-ghost" id="cta-github">View on GitHub <span aria-hidden="true">›</span></a>
      </div>
      <p class="mt-8 sm:mt-6 t-caption text-[var(--color-graphite)]">Requires macOS 15 or later</p>
    </div>
  </section>

  {/* ───────── Footer ───────── */}
  <footer class="bg-[var(--color-snow)] site-footer">
    <div class="mx-auto max-w-[1200px] px-6 py-10 flex flex-row items-center justify-between gap-4 t-caption text-[var(--color-graphite)]">
      <p>© {new Date().getFullYear()} Pluk.</p>
      <div class="flex items-center gap-5 sm:gap-7">
        <a href={repoUrl} class="hover:text-[var(--color-ink)] transition-colors">GitHub</a>
        <a href={releasesUrl} class="hover:text-[var(--color-ink)] transition-colors">Releases</a>
        <a href={`${repoUrl}/issues`} class="hover:text-[var(--color-ink)] transition-colors">Issues</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Display typography — fluid via clamp() */
  .hero-eyebrow {
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: clamp(22px, 3.2vw, 32px);
    line-height: 1.125;
    letter-spacing: 0.004em;
  }
  .hero-title {
    color: #000;
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: clamp(40px, 7.5vw, 72px);
    line-height: 1.05556;
    letter-spacing: -0.012em;
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 580px;
    color: var(--color-slate);
    font-family: var(--font-sf-text);
    font-size: clamp(17px, 2.2vw, 21px);
    line-height: 1.45;
    letter-spacing: -0.2px;
  }
  .section-title {
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: clamp(28px, 4.4vw, 40px);
    line-height: 1.17;
    letter-spacing: -0.6px;
    max-width: 820px;
  }

  /* ── Before / after ─────────────────────────────────────────────── */
  .ba-intro {
    margin-top: 18px;
    max-width: 620px;
    color: var(--color-slate);
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.1px;
  }
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 44px 1fr;
    align-items: stretch;
    gap: 16px;
  }
  .ba-pane {
    display: flex;
    flex-direction: column;
  }
  .ba-window {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: var(--color-snow);
    border-radius: 14px;
    overflow: hidden;
    text-align: left;
    box-shadow:
      0 0 0 0.5px rgba(0, 0, 0, 0.08),
      0 12px 32px -12px rgba(0, 0, 0, 0.12);
  }
  .ba-titlebar {
    position: relative;
    height: 34px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    background: var(--color-fog);
    border-bottom: 1px solid var(--color-silver-mist);
  }
  .ba-lights {
    display: flex;
    gap: 7px;
  }
  .ba-lights i {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--color-silver-mist);
  }
  .ba-lights--color i:nth-child(1) { background: #ff5f57; }
  .ba-lights--color i:nth-child(2) { background: #febc2e; }
  .ba-lights--color i:nth-child(3) { background: #28c840; }
  .ba-filename {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-graphite);
    pointer-events: none;
  }
  .ba-raw {
    flex: 1;
    margin: 0;
    padding: 24px 26px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-slate);
    white-space: pre-wrap;
    overflow: hidden;
  }
  .ba-rendered {
    flex: 1;
    padding: 24px 28px;
  }
  .ba-rendered h3 {
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--color-ink);
  }
  .ba-rendered h4 {
    margin-top: 18px;
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.2px;
    color: var(--color-ink);
  }
  .ba-rendered p {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-slate);
  }
  .ba-rendered ul {
    margin-top: 8px;
    padding-left: 20px;
    list-style: disc;
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-slate);
  }
  .ba-rendered blockquote {
    margin-top: 14px;
    padding: 8px 14px;
    border-left: 2px solid var(--color-silver-mist);
    font-size: 15px;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-ash);
    background: var(--color-fog);
    border-radius: 0 8px 8px 0;
  }
  .ba-arrow {
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--color-silver-mist);
    color: var(--color-ink);
  }
  .ba-caption {
    margin-top: 14px;
    text-align: center;
    font-size: 14px;
    letter-spacing: -0.04px;
    color: var(--color-graphite);
  }
  .ba-caption strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  @media (max-width: 820px) {
    .ba-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .ba-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
  .closing-title {
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: clamp(36px, 6.5vw, 56px);
    line-height: 1.07;
    letter-spacing: -0.9px;
  }
  .faq-title {
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: clamp(30px, 4.6vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.8px;
  }
  .faq-list {
    border-top: 1px solid var(--color-silver-mist);
  }
  .faq-item {
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1fr);
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--color-silver-mist);
  }
  .faq-item dt {
    color: var(--color-ink);
    font-family: var(--font-sf-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.2px;
  }
  .faq-item dd {
    color: var(--color-slate);
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.1px;
  }
  @media (max-width: 720px) {
    .faq-item {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
  }

  /* Features carousel container */
  .features-scroller {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    --gutter: max(24px, calc((100vw - 1200px) / 2 + 24px));
    scroll-padding-inline-start: var(--gutter);
    scroll-padding-inline-end: var(--gutter);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .features-scroller::-webkit-scrollbar { display: none; }
  .features-spacer { flex-shrink: 0; width: var(--gutter); }

  /* Card fallback mocks (only render when a screenshot is missing) */
  .card-mock-wrap {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
  }
  .card-mock-wrap--column { flex-direction: column; gap: 20px; }

  .card-mock-paper {
    background: var(--color-snow);
    width: 100%;
    max-width: 360px;
    aspect-ratio: 5 / 4;
    padding: 28px;
    overflow: hidden;
    border-radius: 14px;
  }
  .card-mock-paper--narrow {
    max-width: 300px;
    aspect-ratio: auto;
    padding: 24px;
    border-radius: 12px;
  }
  .card-mock-title {
    font-family: var(--font-sf-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.012em;
    color: var(--color-ink);
  }
  .kbd-key {
    color: var(--color-ink);
    background: var(--color-snow);
    font-family: var(--font-sf-text);
    font-weight: 500;
    font-size: 28px;
    line-height: 1;
    padding: 22px 38px;
    border-radius: 14px;
    border: 1px solid var(--color-silver-mist);
    letter-spacing: -0.01em;
  }
  .editor-tile {
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    border-radius: 16px;
    font-family: var(--font-sf-display);
    font-weight: 700;
    font-size: 28px;
  }

  /* Pagination buttons */
  .arrow-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 999px;
    background: var(--color-silver-mist);
    color: var(--color-ink);
    transition: background-color 0.18s ease;
  }
  .arrow-btn:hover { background: #d8d8dc; }
</style>

<script is:inline>
  (() => {
    // Feature carousel
    const scroller = document.getElementById('features-scroller');
    const prev = document.getElementById('features-prev');
    const next = document.getElementById('features-next');
    if (scroller && prev && next) {
      const step = () => {
        const card = scroller.querySelector('article');
        return card ? card.getBoundingClientRect().width + 24 : 480;
      };
      prev.addEventListener('click', () => {
        scroller.scrollBy({ left: -step(), behavior: 'smooth' });
        window.posthog?.capture('feature_carousel_navigated', { direction: 'prev' });
      });
      next.addEventListener('click', () => {
        scroller.scrollBy({ left: step(), behavior: 'smooth' });
        window.posthog?.capture('feature_carousel_navigated', { direction: 'next' });
      });
    }

    // Closing CTA tracking
    document.getElementById('cta-download')?.addEventListener('click', () => {
      window.posthog?.capture('download_clicked', { location: 'closing_cta' });
    });
    document.getElementById('cta-github')?.addEventListener('click', () => {
      window.posthog?.capture('github_link_clicked', { location: 'closing_cta' });
    });
  })();
</script>
