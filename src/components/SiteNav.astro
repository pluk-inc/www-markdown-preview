---
/** Sticky frosted top bar, shared by every page. */
import { DOWNLOAD_URL, REPO_URL, SPONSOR_URL } from "../consts";
---

<header id="site-header" class="sticky top-0 z-50 site-nav">
  <div class="mx-auto max-w-[1200px] px-6">
    <nav class="flex items-center justify-between gap-3 h-11">
      <a href="/" class="t-caption font-semibold whitespace-nowrap text-[var(--color-ink)]">Markdown Preview</a>
      <div class="flex items-center whitespace-nowrap gap-3.5 sm:gap-6 t-caption text-[var(--color-ink)]">
        <a href="/#features" class="hidden sm:inline opacity-80 hover:opacity-100 transition-opacity">Features</a>
        <a href={REPO_URL} class="hidden min-[360px]:inline opacity-80 hover:opacity-100 transition-opacity" id="nav-github">GitHub</a>
        <a
          href={SPONSOR_URL}
          target="_blank"
          rel="noopener"
          class="opacity-80 hover:opacity-100 transition-opacity"
          id="nav-sponsor">Support</a
        >
        <a href={DOWNLOAD_URL} class="btn-pill btn-pill--sm" id="nav-download">Download</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Frosted nav — --color-fog at 72% */
  .site-nav {
    background-color: rgba(245, 245, 247, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }
</style>

<script is:inline>
  document.getElementById('nav-download')?.addEventListener('click', () => {
    window.posthog?.capture('download_clicked', { location: 'nav' });
  });
  document.getElementById('nav-sponsor')?.addEventListener('click', () => {
    window.posthog?.capture('sponsor_clicked', { location: 'nav' });
  });
  document.getElementById('nav-github')?.addEventListener('click', () => {
    window.posthog?.capture('github_link_clicked', { location: 'nav' });
  });
</script>
